# Build artifacts
build/
# dist/* not dist/: git cannot re-include a file whose parent directory is
# excluded, and the single-file build is a published download path.
dist/*
!dist/commitclerk.py
*.egg-info/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — never commit your API key
.env
.env.*
!.env.example

# Editors and IDEs
.idea/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db
desktop.ini
